APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_STACK=single
LOG_CHANNEL=stack
LOG_STACKa=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Direct (non-pooled) endpoint — required for migrations. See lesson in
# docs/day-10-remaining-work.md: pooled endpoint causes DDL failures.
DB_HOST_POOLED=
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Neon and most managed Postgres hosts require SSL.
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# --- AI providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT=60

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Malware scanning ---
CLAMAV_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# --- Google auth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Auth / security tuning ---
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
VERIFICATION_CODE_EXPIRY_MINUTES=15
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

# Dev-only conveniences — MUST be false/unset in any shared or production
# environment. These expose values that would otherwise only go out via
# email, purely so local development doesn't require a working mailer.
EXPOSE_DEV_PASSWORD_RESET_TOKEN=false
EXPOSE_DEV_VERIFICATION_CODE=false

DOC_MAX_UPLOAD_KB=20480
DOC_AUTO_EXTRACT_CLASSIFICATIONS=Public,Internal,Confidential
DOC_MAX_EXTRACTION_CHARS=60000

# --- Horizon dashboard (comma-separated admin emails; empty = deny all) ---
HORIZON_AUTHORIZED_EMAILS=

# --- Power BI reporting ---
# Reporting uses direct Postgres credentials per workspace (RLS), not Azure
# REST vars. See docs/POWERBI_SETUP.md and docs/day-10-remaining-work.md.

# --- Transactional email ---
RESEND_API_KEY=
