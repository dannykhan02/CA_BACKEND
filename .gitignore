dan@Wu-Tang:~/Development/code/Wu-Tang/flask/January/CA/backend$ # 1. Signup — triggers a verification code, logged since MAIL_MAILER=log
curl -s -X POST http://localhost:8000/api/auth/signup \
  -H "Content-Type: application/json" \
  -d '{"full_name":"Verify Test","email":"verify123@ca.go.ke","password":"password123","password_confirmation":"password123"}' | jq

# pull the code straight from the log
tail -5 storage/logs/laravel.log | grep -oE "Verification code for verify@ca.go.ke: [0-9]{6}"
