# 3. Verify with the CORRECT code (paste the real code from step 1's log output) — expect 200
curl -s -X POST http://localhost:8000/api/auth/verify-email \
  -H "Content-Type: application/json" \
  -d '{"email":"verify123@ca.go.ke","code":"PASTE_REAL_CODE_HERE"}' | jq


  



  # 5. Resend verification for a DIFFERENT, unverified user — expect a new code in the log
curl -s -X POST http://localhost:8000/api/auth/signup \
  -H "Content-Type: application/json" \
  -d '{"full_name":"Resend Test","email":"resend123@ca.go.ke","password":"password123","password_confirmation":"password123"}' | jq

curl -s -X POST http://localhost:8000/api/auth/resend-verification \
  -H "Content-Type: application/json" \
  -d '{"email":"resend123@ca.go.ke"}' | jq

tail -5 storage/logs/laravel.log | grep -oE "Verification code for resend@ca.go.ke: [0-9]{6}"