            "claims": [
                {
                    "text": "India faced a data fragmentation challenge in WASH measurement, with fragmented definitions, reporting formats and data systems making it difficult to measure progress consistently and spotlight inequalities.",
                    "cites": [
                        "risk:44"
                    ]
                },
                {
                    "text": "The Government of India launched the Swachh Bharat (Clean India) Mission in 2014, and 110 million toilets were constructed under it.",
                    "cites": [
                        "fact:01a126fa-f450-72e0-ab2e-5337393aa52d",
                        "kpi:156"
                    ]
                },
                {
                    "text": "India reached 580 million people with improved drinking water and 550 million people with basic sanitation in the last 10 years.",
                    "cites": [
                        "kpi:153",
                        "kpi:152"
                    ]
                },
                {
                    "text": "In 2024, 59.3 million people in India accessed safely managed water and 17.9 million accessed safely managed sanitation.",
                    "cites": [
                        "kpi:160",
                        "kpi:159"
                    ]
                },
                {
                    "text": "The Government of India invested over $120 billion in water and sanitation.",
                    "cites": [
                        "kpi:155"
                    ]
                },
                {
                    "text": "India launched the Jal Jeevan (Water is Life) Mission to achieve universal access to safe and adequate drinking water.",
                    "cites": [
                        "fact:01a126fa-f451-72b9-826e-fffe994c4da6"
                    ]
                }
